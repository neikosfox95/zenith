# ============================================================
# Zenith backend configuration
# ------------------------------------------------------------
# Copy to `.env` and fill in. EVERY value here is optional — the server boots
# without a .env file and reports what is missing on GET /api/health
# (`warnings[]`) and in the startup banner. That is deliberate: a missing
# optional integration must never stop the API from serving.
#
# Real environment variables always win over this file.
# ============================================================

NODE_ENV=development

# ------------------------------------------------------------
# HTTP server
# ------------------------------------------------------------
PORT=8001
HOST=0.0.0.0
# Must be truthy behind nginx / a preview proxy, otherwise every client shares
# one IP and the API rate limiter locks the whole app out.
TRUST_PROXY=true
BODY_LIMIT=10mb
# Log requests that are slow (>1s) or failed (>=400).
REQUEST_LOG=true
SHUTDOWN_TIMEOUT_MS=10000

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# REQUIRED in production — the process refuses to start without it when
# NODE_ENV=production. In development a stable secret is generated into
# backend/.dev-jwt-secret (gitignored) so tokens survive restarts.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=zenith
BCRYPT_SALT_ROUNDS=10

HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# Comma-separated allow-list. Empty (or "*") in development = permissive.
# In production, set this explicitly; "*" is reported as a health warning.
CORS_ORIGINS=
CORS_CREDENTIALS=true

# `enforce` (default) = 401 without a valid token on the router groups that
# previously had no auth at all. `permissive` = allow but log, for auditing.
AUTH_MODE=enforce

# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=zenith
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_MAX_POOL_SIZE=20
MONGO_RETRY_INTERVAL_MS=15000
# false (default): boot immediately, DB routes answer 503 until Mongo is up.
# true: block startup until Mongo connects (only for batch/worker processes).
MONGO_BLOCK_STARTUP=false

# ------------------------------------------------------------
# Redis (optional — falls back to an in-memory cache automatically)
# ------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------
# Storage paths
# ------------------------------------------------------------
# All relative paths resolve against the repository. The defaults below are
# what you want unless you are mounting a volume.
# DATA_ROOT=backend/storage
# UPLOADS_DIR=backend/storage/uploads
# AUDIO_STORAGE_DIR=backend/storage/audio
# RECORDINGS_DIR=backend/storage/recorded_streams
UPLOADS_PUBLIC_URL=/uploads
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_FILES=10

# ------------------------------------------------------------
# MinIO / S3 object storage (optional — local disk is used when unset)
# ------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET=voice-audio

# ------------------------------------------------------------
# AI providers (optional — AI endpoints answer 503 until one is configured)
# ------------------------------------------------------------
# EMERGENT_LLM_KEY is used as the fallback for OpenAI- and Google-compatible
# calls when their dedicated keys are absent.
EMERGENT_LLM_KEY=
ATLAS_CLOUD_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Email (optional — email notifications are skipped when unset)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tiktokmonitor.com

# ------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------
RL_API_WINDOW_MS=900000
RL_API_MAX=300
RL_AUTH_WINDOW_MS=900000
RL_AUTH_MAX=10
RL_AI_WINDOW_MS=3600000
RL_AI_MAX=50
RL_UPLOAD_WINDOW_MS=900000
RL_UPLOAD_MAX=30
# Auto-enabled when NODE_ENV=test so integration tests are deterministic.
RATE_LIMIT_DISABLED=false

# ------------------------------------------------------------
# Debug
# ------------------------------------------------------------
SOCKET_DEBUG=false
