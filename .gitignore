# ============================================================
# Zenith — .gitignore
# ------------------------------------------------------------
# Consolidated: this file previously contained three duplicated
# "Environment files" blocks plus literal `-e ` lines (shell artifacts from an
# `echo -e` that was never quoted) and `android-sdk/ -e `, which git treats as
# a *pattern* and therefore never matched anything.
# ============================================================

# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/install-state.gz

# ------------------------------------------------------------
# Environment & credentials
# ------------------------------------------------------------
.env
.env.*
*.env
*.env.*
# …but the documented template must stay in the repo.
!.env.example
!*.env.example

credentials.json
*credentials.json*
*token.json*
.credentials
*.pem
*.key

# Generated when JWT_SECRET is unset in development (see backend/config).
backend/.dev-jwt-secret
.dev-jwt-secret

# ------------------------------------------------------------
# Runtime data — generated by the API, never source
# ------------------------------------------------------------
# Replaces the old hardcoded /app/backend/uploads and /app/storage paths;
# everything the server writes now lands under backend/storage by default.
backend/storage/
backend/uploads/
backend/recorded_streams/
storage/
*.log
logs/
dump.rdb

# ------------------------------------------------------------
# Build output
# ------------------------------------------------------------
/build
build/
dist/
dist
/out/
/.next/
.expo/
.metro-cache/
next-env.d.ts
*.tsbuildinfo
web-build/

# Android / iOS build trees (generated by expo prebuild)
android/
ios/
android-sdk/

# ------------------------------------------------------------
# Testing & coverage
# ------------------------------------------------------------
/coverage
coverage/
.nyc_output/
.pytest_cache/
test_reports/pytest/

# ------------------------------------------------------------
# Caches
# ------------------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.eslintcache

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/
.ipynb_checkpoints/

# ------------------------------------------------------------
# Editors & OS
# ------------------------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# Misc / deployment
# ------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
chainlit.md
.chainlit
.ac
agenthub/agents/youtube/db

# Archives & large binaries
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib
